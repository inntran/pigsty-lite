---
profile: production

exclude_paths:
  - .git/
  - .ansible/
  - collections/
  - tests/molecule/*/molecule.yml

skip_list:
  - role-name  # we use single-word role names by design
  - var-naming[no-role-prefix]  # shared vars (e.g. epel_repo_id) are intentionally cross-role

warn_list: []

kinds:
  - playbook: "playbooks/*.yml"
  - tasks: "roles/*/tasks/*.yml"
  - vars: "roles/*/vars/*.yml"
  - meta: "roles/*/meta/main.yml"
