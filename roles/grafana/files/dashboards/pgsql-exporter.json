{
  "id": null,
  "uid": "pgsql-exporter",
  "title": "PostgreSQL Exporter",
  "description": "Adapted from Pigsty pgsql/pgsql-exporter.json for prometheus-community/postgres_exporter and pigsty-lite scrape labels.",
  "tags": [
    "pigsty",
    "postgresql",
    "postgres_exporter"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {
          "type": "victoriametrics-metrics-datasource",
          "uid": "VictoriaMetrics"
        },
        "query": "label_values(up{job=\"postgres\"}, cluster)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "victoriametrics-metrics-datasource",
          "uid": "VictoriaMetrics"
        },
        "query": "label_values(up{job=\"postgres\",cluster=~\"$cluster\"}, instance)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 149,
      "title": "Overview",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 144,
      "title": "Exporter targets up",
      "type": "stat",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "VictoriaMetrics"
          },
          "expr": "sum(up{job=\"postgres\",cluster=~\"$cluster\",instance=~\"$instance\"})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 145,
      "title": "PostgreSQL reachable",
      "type": "stat",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "VictoriaMetrics"
          },
          "expr": "sum(pg_up{job=\"postgres\",cluster=~\"$cluster\",instance=~\"$instance\"})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 136,
      "title": "Last scrape errors",
      "type": "stat",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "VictoriaMetrics"
          },
          "expr": "sum(pg_exporter_last_scrape_error{job=\"postgres\",cluster=~\"$cluster\",instance=~\"$instance\"})",
          "refId": "A"
        }
      ],
      "description": "Number of exporters whose last database metrics scrape failed."
    },
    {
      "id": 138,
      "title": "Longest database scrape",
      "type": "stat",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "VictoriaMetrics"
          },
          "expr": "max(pg_exporter_last_scrape_duration_seconds{job=\"postgres\",cluster=~\"$cluster\",instance=~\"$instance\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 150,
      "title": "Exporter health",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "panels": []
    },
    {
      "id": 128,
      "title": "Exporter and PostgreSQL aliveness",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "VictoriaMetrics"
          },
          "expr": "up{job=\"postgres\",cluster=~\"$cluster\",instance=~\"$instance\"}",
          "refId": "A",
          "legendFormat": "exporter {{instance}}"
        },
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "VictoriaMetrics"
          },
          "expr": "pg_up{job=\"postgres\",cluster=~\"$cluster\",instance=~\"$instance\"}",
          "refId": "B",
          "legendFormat": "postgres {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "description": "up reports whether VictoriaMetrics can scrape postgres_exporter; pg_up reports whether it can connect to PostgreSQL."
    },
    {
      "id": 129,
      "title": "Database scrape duration",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "VictoriaMetrics"
          },
          "expr": "pg_exporter_last_scrape_duration_seconds{job=\"postgres\",cluster=~\"$cluster\",instance=~\"$instance\"}",
          "refId": "A",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 147,
      "title": "Database scrape errors",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "VictoriaMetrics"
          },
          "expr": "pg_exporter_last_scrape_error{job=\"postgres\",cluster=~\"$cluster\",instance=~\"$instance\"}",
          "refId": "A",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "description": "The community exporter emits this gauge as 1 for an error and 0 for success."
    },
    {
      "id": 126,
      "title": "Database scrapes per minute",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "VictoriaMetrics"
          },
          "expr": "rate(pg_exporter_scrapes_total{job=\"postgres\",cluster=~\"$cluster\",instance=~\"$instance\"}[$__rate_interval]) * 60",
          "refId": "A",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 152,
      "title": "Collectors",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "panels": []
    },
    {
      "id": 131,
      "title": "Collector duration",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "VictoriaMetrics"
          },
          "expr": "pg_scrape_collector_duration_seconds{job=\"postgres\",cluster=~\"$cluster\",instance=~\"$instance\"}",
          "refId": "A",
          "legendFormat": "{{instance}} / {{collector}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 123,
      "title": "Collector success",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "VictoriaMetrics"
          },
          "expr": "pg_scrape_collector_success{job=\"postgres\",cluster=~\"$cluster\",instance=~\"$instance\"}",
          "refId": "A",
          "legendFormat": "{{instance}} / {{collector}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "description": "A value of 0 identifies a failing postgres_exporter collector."
    },
    {
      "id": 153,
      "title": "Process",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "panels": []
    },
    {
      "id": 124,
      "title": "Exporter uptime",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 33
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "VictoriaMetrics"
          },
          "expr": "time() - process_start_time_seconds{job=\"postgres\",cluster=~\"$cluster\",instance=~\"$instance\"}",
          "refId": "A",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 132,
      "title": "Exporter memory",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 33
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "VictoriaMetrics"
          },
          "expr": "process_resident_memory_bytes{job=\"postgres\",cluster=~\"$cluster\",instance=~\"$instance\"}",
          "refId": "A",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    }
  ]
}
