# {{ ansible_managed }}
# Rendered by roles/patroni. Do not edit by hand. To change tunables,
# edit inventory variables and re-run `make deploy`.
{#
  One pg_hba rule dict -> one pg_hba.conf line. Accepts the role spelling
  (databases/users) and the response-file spelling (db/user). The system
  rules' CIDRs come from patroni_hba_{any,loopback}_cidr, which follow the
  deployment's address family: an IPv4 0.0.0.0/0 never matches an IPv6 peer.
#}
{%- macro hba_line(rule) -%}
{%-   set contype = rule.contype | default('hostssl', true) -%}
{%-   set columns = [contype, rule.databases | default(rule.db, true), rule.users | default(rule.user, true)] -%}
{%-   if contype != 'local' -%}{%- set columns = columns + [rule.source] -%}{%- endif -%}
{{ (columns + [rule.method | default('scram-sha-256', true)]) | join(' ') }}
{%- endmacro -%}

scope: {{ patroni_scope | to_json }}
namespace: {{ patroni_namespace | to_json }}
name: {{ inventory_hostname | to_json }}

restapi:
  listen: {{ patroni_listen_address }}:{{ patroni_rest_port }}
  connect_address: {{ patroni_advertise_address }}:{{ patroni_rest_port }}
  certfile: {{ patroni_cert_file }}
  keyfile: {{ patroni_key_file }}
  cafile: {{ patroni_trusted_ca_file }}
  verify_client: optional

ctl:
  certfile: {{ patroni_cert_file }}
  keyfile: {{ patroni_key_file }}
  cafile: {{ patroni_trusted_ca_file }}

etcd3:
  hosts:
{% for h in groups['etcd'] %}
    - "{{ hostvars[h].get('etcd_advertise_address', hostvars[h].get('ansible_host', h)) }}:{{ etcd_client_port | default(2379) }}"
{% endfor %}
  protocol: {{ patroni_etcd_protocol }}
  cacert: {{ patroni_trusted_ca_file }}
  cert: {{ patroni_cert_file }}
  key: {{ patroni_key_file }}

bootstrap:
  dcs:
    ttl: 30
    loop_wait: 10
    retry_timeout: 10
    maximum_lag_on_failover: 1048576
    synchronous_mode: false
    postgresql:
      use_pg_rewind: true
      use_slots: true
      parameters:
{% set memtotal_mb = ansible_facts.get('memtotal_mb', 4096) | int %}
{% set shared_buffers_mb = ((memtotal_mb * (patroni_shared_buffer_ratio | float)) | int) %}
{% set effective_cache_mb = ((memtotal_mb * 0.6) | int) %}
{% set work_mem_mb = ([(memtotal_mb // 64), 4] | max) %}
{% set maint_mem_mb = ([(memtotal_mb // 16), 64] | max) %}
        shared_buffers: {{ shared_buffers_mb }}MB
        effective_cache_size: {{ effective_cache_mb }}MB
        work_mem: {{ work_mem_mb }}MB
        maintenance_work_mem: {{ maint_mem_mb }}MB
        ssl: "on"
        ssl_min_protocol_version: "TLSv1.2"
        # archive_mode is enabled at cluster bootstrap so later toggling
        # of archive_command via DCS dynamic config (PATCH /config) takes
        # effect via SIGHUP without a postmaster restart. archive_command
        # itself is set by roles/pgbackrest's _archive.yml, not here.
        archive_mode: "on"

  initdb:
    - encoding: UTF8
    - data-checksums
    - locale: C.UTF-8

  # No bootstrap.pg_hba: Patroni ignores it whenever postgresql.pg_hba is set
  # (append_pg_hba is a no-op then), and postgresql.pg_hba is always set.

  # Patroni >= 4.0.0 removed the `bootstrap.users` block; superuser,
  # replication, and rewind roles are created from
  # `postgresql.authentication.*` below at initdb time.

postgresql:
  # The whole pg_hba.conf. Patroni writes it on every member at start and on
  # every reload; hand edits are reverted. Order: system, monitor, operator.
  pg_hba:
{% for rule in patroni_hba_system_rules + patroni_hba_monitor_rules + patroni_hba_operator_rules %}
    - {{ hba_line(rule) | to_json }}
{% endfor %}
  listen: {{ patroni_postgres_listen_address }}:{{ patroni_postgres_port }}
  connect_address: {{ patroni_advertise_address }}:{{ patroni_postgres_port }}
  data_dir: {{ patroni_postgres_data_dir }}
  bin_dir: /usr/pgsql-{{ postgres_version }}/bin
  pgpass: /var/lib/pgsql/.pgpass_patroni
  authentication:
    superuser:
      username: {{ patroni_superuser }}
      password: {{ patroni_superuser_password | to_json }}
    replication:
      username: {{ patroni_replication_user }}
      password: {{ patroni_replication_password | to_json }}
      sslmode: verify-ca
      sslrootcert: {{ patroni_trusted_ca_file }}
    rewind:
      username: {{ patroni_rewind_user }}
      password: {{ patroni_rewind_password | to_json }}
      sslmode: verify-ca
      sslrootcert: {{ patroni_trusted_ca_file }}

  parameters:
    ssl_cert_file: {{ patroni_cert_file | to_json }}
    ssl_key_file: {{ patroni_key_file | to_json }}
    ssl_ca_file: {{ patroni_trusted_ca_file | to_json }}
{% set tune_path = role_path ~ '/files/tuning/' ~ patroni_tune_profile ~ '.conf' %}
{% for line in (lookup('file', tune_path)).splitlines() %}
{%   set stripped = line.strip() %}
{%   if stripped and not stripped.startswith('#') and '=' in stripped %}
{%     set item = stripped.split('=', 1) %}
{%     set value = item[1].strip() %}
{%     if (value.startswith("'") and value.endswith("'")) or (value.startswith('"') and value.endswith('"')) %}
{%       set value = value[1:-1] %}
{%     endif %}
    {{ item[0].strip() }}: {{ value | to_json }}
{%   endif %}
{% endfor %}
{% for k, v in (postgres_extra_parameters | default({})).items() %}
    {{ k }}: {{ v | to_json }}
{% endfor %}

tags:
  nofailover: false
  noloadbalance: false
  clonefrom: false
  nosync: false
