#!/usr/bin/env python3
"""pigsty-lite configure CLI.

Modes:
  ./configure                  Interactive wizard (TTY required)
  ./configure -c {spof,ha}     Preset profile, prompts for the rest
  ./configure -s -f FILE       Silent: load FILE, validate, regenerate
  ./configure --validate FILE  Validate FILE and exit

The interactive wizard writes only the response file (the source of truth):
  responses/site.rsp.yml
Silent mode (-s -f) also generates the derived files:
  inventory/site.yml
  group_vars/response.yml
Regenerate the derived files any time with `make regen`.
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

import yaml

ROOT = Path(__file__).resolve().parent
sys.path.insert(0, str(ROOT))

from bin._generate_inventory import generate as gen_inventory  # noqa: E402
from bin._generate_response_vars import generate as gen_response_vars  # noqa: E402
from bin._response_schema import SchemaError, validate  # noqa: E402
from bin import _passwords, _vault  # noqa: E402

INVENTORY_PATH = ROOT / "inventory" / "site.yml"
RESPONSE_VARS_PATH = ROOT / "group_vars" / "response.yml"
RESPONSE_FILE_PATH = ROOT / "responses" / "site.rsp.yml"
VAULT_PATH = ROOT / "group_vars" / "all" / "vault.yml"
VAULT_PASSPHRASE_PATH = ROOT / ".pigsty" / "vault-pass"


def _load_yaml(path: Path) -> dict:
    with path.open() as fh:
        return yaml.safe_load(fh)


def _write(path: Path, content: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content)


def _prompt_passphrase() -> str:
    import getpass
    while True:
        first = getpass.getpass("Vault passphrase (min 8 chars): ")
        if len(first) < 8:
            print("Too short, try again.")
            continue
        second = getpass.getpass("Confirm: ")
        if first != second:
            print("Did not match, try again.")
            continue
        return first


def _ensure_vault_interactive() -> int:
    """Ensure passphrase file + vault file exist; fill in missing secrets."""
    if not VAULT_PASSPHRASE_PATH.exists():
        print(f"No vault passphrase found at {VAULT_PASSPHRASE_PATH}; creating one.")
        VAULT_PASSPHRASE_PATH.parent.mkdir(parents=True, exist_ok=True)
        VAULT_PASSPHRASE_PATH.write_text(_prompt_passphrase() + "\n")
        VAULT_PASSPHRASE_PATH.chmod(0o600)
        print(f"Wrote {VAULT_PASSPHRASE_PATH.relative_to(ROOT)} (back this up!)")

    if _vault.vault_exists(VAULT_PATH):
        existing = _vault.vault_read(VAULT_PATH, VAULT_PASSPHRASE_PATH)
    else:
        existing = {}

    import getpass
    updated = _passwords.ensure_machine_secrets(existing)
    updated = _passwords.ensure_human_secrets(
        updated,
        prompter=lambda label: getpass.getpass(f"Password for {label}: "),
    )
    if updated != existing:
        _vault.vault_write(VAULT_PATH, updated, VAULT_PASSPHRASE_PATH)
        print(f"Wrote {VAULT_PATH.relative_to(ROOT)} (encrypted)")
    else:
        print(f"Vault up to date at {VAULT_PATH.relative_to(ROOT)}")
    return 0


def _ensure_vault_silent() -> int:
    """In silent mode: refuse to prompt; require vault to already exist."""
    if not VAULT_PASSPHRASE_PATH.exists():
        print(
            f"ERROR: silent mode requires {VAULT_PASSPHRASE_PATH.relative_to(ROOT)} "
            "to exist (run interactive configure first to bootstrap the vault)",
            file=sys.stderr,
        )
        return 1
    if not _vault.vault_exists(VAULT_PATH):
        updated = _passwords.ensure_machine_secrets({})
        _vault.vault_write(VAULT_PATH, updated, VAULT_PASSPHRASE_PATH)
        print(f"Wrote {VAULT_PATH.relative_to(ROOT)} (machine secrets only)")
        return 0
    existing = _vault.vault_read(VAULT_PATH, VAULT_PASSPHRASE_PATH)
    updated = _passwords.ensure_machine_secrets(existing)
    if updated != existing:
        _vault.vault_write(VAULT_PATH, updated, VAULT_PASSPHRASE_PATH)
        print(f"Updated {VAULT_PATH.relative_to(ROOT)} (new machine secrets)")
    return 0


def cmd_rotate(args: argparse.Namespace) -> int:
    if not VAULT_PASSPHRASE_PATH.exists():
        print(f"ERROR: no passphrase at {VAULT_PASSPHRASE_PATH}", file=sys.stderr)
        return 1
    if not _vault.vault_exists(VAULT_PATH):
        print(f"ERROR: no vault at {VAULT_PATH}", file=sys.stderr)
        return 1
    existing = _vault.vault_read(VAULT_PATH, VAULT_PASSPHRASE_PATH)
    try:
        updated = _passwords.rotate(existing, args.rotate)
    except ValueError as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return 2
    _vault.vault_write(VAULT_PATH, updated, VAULT_PASSPHRASE_PATH)
    print(f"Rotated {args.rotate} in {VAULT_PATH.relative_to(ROOT)}")
    return 0


def cmd_validate(args: argparse.Namespace) -> int:
    try:
        data = _load_yaml(Path(args.validate))
        validate(data)
    except SchemaError as exc:
        print(f"INVALID: {exc}", file=sys.stderr)
        return 2
    except (OSError, yaml.YAMLError) as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return 1
    print("OK")
    return 0


def cmd_silent(args: argparse.Namespace) -> int:
    src = Path(args.file)
    try:
        data = _load_yaml(src)
        validate(data)
    except SchemaError as exc:
        print(f"INVALID: {exc}", file=sys.stderr)
        return 2
    except (OSError, yaml.YAMLError) as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return 1
    _write(INVENTORY_PATH, gen_inventory(data))
    _write(RESPONSE_VARS_PATH, gen_response_vars(data))
    print(f"Wrote {INVENTORY_PATH.relative_to(ROOT)}")
    print(f"Wrote {RESPONSE_VARS_PATH.relative_to(ROOT)}")
    if not args.no_vault:
        rc = _ensure_vault_silent()
        if rc != 0:
            return rc
    return 0


def cmd_interactive(args: argparse.Namespace) -> int:
    if not sys.stdin.isatty():
        print(
            "ERROR: interactive mode requires a TTY; use -s -f FILE for silent mode",
            file=sys.stderr,
        )
        return 1
    print("pigsty-lite interactive configure")
    print("(P0 implements minimal prompts; future tasks extend this)")
    print()
    profile = args.profile or input("Profile (spof|ha) [ha]: ").strip() or "ha"
    cluster_name = input("Cluster name [pg-prod]: ").strip() or "pg-prod"
    cluster_domain = input("Cluster domain [example.internal]: ").strip() or "example.internal"
    remote_user = input("Remote user [dba]: ").strip() or "dba"

    example_name = f"{profile}.rsp.yml.example"
    example_path = ROOT / "responses" / example_name
    if not example_path.exists():
        print(f"ERROR: missing template {example_path}", file=sys.stderr)
        return 1
    data = _load_yaml(example_path)
    data["profile"] = profile
    data["cluster"]["name"] = cluster_name
    data["cluster"]["domain"] = cluster_domain
    data["access"] = {"ansible_user": remote_user}

    try:
        validate(data)
    except SchemaError as exc:
        print(f"INVALID generated response: {exc}", file=sys.stderr)
        return 2

    # The wizard only writes the response file (the source of truth).
    # inventory/site.yml and group_vars/response.yml are derived; they are
    # generated from the response file by `make regen` (and by `-s -f`).
    RESPONSE_FILE_PATH.parent.mkdir(parents=True, exist_ok=True)
    with RESPONSE_FILE_PATH.open("w") as fh:
        yaml.safe_dump(data, fh, sort_keys=False, explicit_start=True)
    print(f"Wrote {RESPONSE_FILE_PATH.relative_to(ROOT)}")
    if not args.no_vault:
        rc = _ensure_vault_interactive()
        if rc != 0:
            return rc
    print()
    print(
        "Edit responses/site.rsp.yml to fill IPv4/IPv6 IPs, then: make plan\n"
        "(make plan/deploy regenerate inventory/site.yml and"
        " group_vars/response.yml from the response file automatically)"
    )
    print()
    contract_lines = [
        "BEFORE you run `make plan` / `make deploy`:",
        "",
        f"The remote user '{remote_user}' must already have, on",
        "EVERY target host:",
        "  1. Passwordless SSH login (SSH key authentication)",
        "  2. NOPASSWD sudo",
        "",
        "pigsty-lite does not set this up. make plan will fail",
        "with a connection or sudo error if it is not in place.",
    ]
    border = "+" + "-" * 62 + "+"
    print(border)
    for text in contract_lines:
        print("|  " + text.ljust(60) + "|")
    print(border)
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="configure", description=__doc__)
    parser.add_argument("--validate", metavar="FILE", help="validate FILE and exit")
    parser.add_argument("-s", "--silent", action="store_true")
    parser.add_argument("-f", "--file", help="response file for silent mode")
    parser.add_argument("-c", "--profile", choices=("spof", "ha"), help="preset profile for wizard")
    parser.add_argument(
        "--no-vault",
        action="store_true",
        help="skip vault bootstrap/update (CI; tests provide passwords explicitly)",
    )
    parser.add_argument(
        "--rotate",
        metavar="KEY",
        help="force-regenerate one vault key (requires existing vault)",
    )
    args = parser.parse_args(argv)

    if args.validate:
        return cmd_validate(args)
    if args.rotate:
        return cmd_rotate(args)
    if args.silent:
        if not args.file:
            parser.error("--silent requires --file")
        return cmd_silent(args)
    return cmd_interactive(args)


if __name__ == "__main__":
    raise SystemExit(main())
